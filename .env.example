# Discord Bot Token (Lấy từ Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Google Gemini API Key (Lấy từ Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# CẤU HÌNH MÔ HÌNH AI PHÂN TẦNG (MULTI-TIER MODELS)
# Chuỗi Fallback: 3.8 flash -> 3.7 flash -> 3.6 flash -> 3.5 flash -> 3.5 flash lite -> 3.1 flash lite -> Gemma 4
# ==========================================
# 1. Model xử lý dữ liệu nền, map chunks thô (Nhẹ, tốc độ cao, tiết kiệm token)
GEMINI_DATA_MODEL=gemini-3.1-flash-lite

# 2. Model tóm tắt tin nhắn & QA Evaluator
GEMINI_MODEL=gemini-3.8-flash
GEMINI_QA_MODEL=gemini-3.8-flash

# 3. Model chuyên sâu luận giải Tarot (Thinking / Deep Reasoning)
GEMINI_TAROT_MODEL=gemini-3.8-flash

# 4. Model phiên dịch Cabin troll trực tiếp
GEMINI_CABIN_MODEL=gemini-3.8-flash

# Port chạy Web Dashboard (Mặc định: 8080)
PORT=8080

# Mật khẩu quản trị Web Console & Khóa phiên Session
ADMIN_PASSWORD=your_admin_password_here
FLASK_SECRET_KEY=your_random_flask_secret_key_here

# ==========================================
# CẤU HÌNH TURSO CLOUD DATABASE (PERSISTENT CLOUD SQLITE)
# ==========================================
# Nếu để trống TURSO_AUTH_TOKEN, bot sẽ tự động sử dụng Local SQLite (data/bot_config.db)
TURSO_DATABASE_URL=libsql://mikebotdb-hoenmike.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here

# ==========================================
# ASUMI EXTERNAL CREDENTIALS / ENVIRONMENT IDENTITY
# ==========================================
# Product feature switches, models, quotas, timeouts, context limits and cache
# live ONLY in core/constants.py. Render requires credentials and identity.
#
# Public Brave search automatically activates when this key is present AND
# the durable Turso quota database is healthy. Configure provider-side
# usage/spend limits before entering the key.
BRAVE_SEARCH_API_KEY=

# Optional Cloudflare Clef router/Workers AI credentials. Account ID is an
# environment-specific identifier (not secret); token must stay secret.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional separate Vectorize token. Semantic Archive is intentionally OFF
# in core/constants.py until real permissions/cost validation is complete.
CLOUDFLARE_VECTORIZE_TOKEN=

# T23 private screenshot storage (needed to persist image evidence).
# All four values are deployment-specific identifiers/secrets, not feature flags.
# Bucket must be PRIVATE; use dedicated R2 S3 key scoped to this bucket.
ASUMI_FEEDBACK_R2_BUCKET=
ASUMI_FEEDBACK_R2_ACCESS_KEY_ID=
ASUMI_FEEDBACK_R2_SECRET_ACCESS_KEY=
