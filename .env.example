# Discord Bot Token (Lấy từ Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Google Gemini API Key (Lấy từ Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# CẤU HÌNH MÔ HÌNH AI PHÂN TẦNG (MULTI-TIER MODELS)
# ==========================================
# 1. Model xử lý dữ liệu nền, map chunks thô (Nhẹ, tốc độ cao, tiết kiệm token)
GEMINI_DATA_MODEL=gemini-3.1-flash-lite

# 2. Model tóm tắt tin nhắn & QA Evaluator
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_QA_MODEL=gemini-3.5-flash-lite

# 3. Model chuyên sâu luận giải Tarot (Thinking / Deep Reasoning)
# Tự động hỗ trợ Fallback: gemini-3.7-flash -> gemini-3.6-flash -> gemini-3.5-flash -> gemini-3.5-flash-lite -> gemma-4-31b-it
GEMINI_TAROT_MODEL=gemini-3.7-flash

# 4. Model dùng cho Meme Reasoning & Vision Multimodal
GEMINI_MEME_MODEL=gemini-3.6-flash

# ==========================================
# CẤU HÌNH MEME ENGINE (TÙY CHỌN - TỰ ĐỘNG FALLBACK NẾU ĐỂ TRỐNG)
# ==========================================
# TENOR_API_KEY=your_tenor_api_key_here
# GIPHY_API_KEY=your_giphy_api_key_here
# GOOGLE_CSE_API_KEY=your_google_cse_api_key_here
# GOOGLE_CSE_CX=your_google_cse_cx_here

# Port chạy Web Dashboard (Mặc định: 8080)
PORT=8080
