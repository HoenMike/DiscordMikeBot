# Discord Bot Token (Lấy từ Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Google Gemini API Key (Lấy từ Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# CẤU HÌNH MÔ HÌNH AI PHÂN TẦNG (MULTI-TIER MODELS)
# Chuỗi Fallback: 3.8 flash -> 3.7 flash -> 3.6 flash -> 3.5 flash -> 3.5 flash lite -> 3.1 flash lite -> Gemma 4
# ==========================================
# 1. Model xử lý dữ liệu nền, map chunks thô (Nhẹ, tốc độ cao, tiết kiệm token)
GEMINI_DATA_MODEL=gemini-3.1-flash-lite

# 2. Model tóm tắt tin nhắn & QA Evaluator
GEMINI_MODEL=gemini-3.8-flash
GEMINI_QA_MODEL=gemini-3.8-flash

# 3. Model chuyên sâu luận giải Tarot (Thinking / Deep Reasoning)
GEMINI_TAROT_MODEL=gemini-3.8-flash

# 4. Model phiên dịch Cabin troll trực tiếp
GEMINI_CABIN_MODEL=gemini-3.8-flash

# Port chạy Web Dashboard (Mặc định: 8080)
PORT=8080

# Mật khẩu quản trị Web Console & Khóa phiên Session
ADMIN_PASSWORD=your_admin_password_here
FLASK_SECRET_KEY=your_random_flask_secret_key_here

# ==========================================
# CẤU HÌNH TURSO CLOUD DATABASE (PERSISTENT CLOUD SQLITE)
# ==========================================
# Nếu để trống TURSO_AUTH_TOKEN, bot sẽ tự động sử dụng Local SQLite (data/bot_config.db)
TURSO_DATABASE_URL=libsql://mikebotdb-hoenmike.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here
