# Discord Bot Token (Lấy từ Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Google Gemini API Key (Lấy từ Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# CẤU HÌNH MÔ HÌNH AI PHÂN TẦNG (MULTI-TIER MODELS)
# Chuỗi Fallback: 3.8 flash -> 3.7 flash -> 3.6 flash -> 3.5 flash -> 3.5 flash lite -> 3.1 flash lite -> Gemma 4
# ==========================================
# 1. Model xử lý dữ liệu nền, map chunks thô (Nhẹ, tốc độ cao, tiết kiệm token)
GEMINI_DATA_MODEL=gemini-3.1-flash-lite

# 2. Model tóm tắt tin nhắn & QA Evaluator
GEMINI_MODEL=gemini-3.8-flash
GEMINI_QA_MODEL=gemini-3.8-flash

# 3. Model chuyên sâu luận giải Tarot (Thinking / Deep Reasoning)
GEMINI_TAROT_MODEL=gemini-3.8-flash

# 4. Model phiên dịch Cabin troll trực tiếp
GEMINI_CABIN_MODEL=gemini-3.8-flash

# Port chạy Web Dashboard (Mặc định: 8080)
PORT=8080

# Mật khẩu quản trị Web Console & Khóa phiên Session
ADMIN_PASSWORD=your_admin_password_here
FLASK_SECRET_KEY=your_random_flask_secret_key_here

# ==========================================
# CẤU HÌNH TURSO CLOUD DATABASE (PERSISTENT CLOUD SQLITE)
# ==========================================
# Nếu để trống TURSO_AUTH_TOKEN, bot sẽ tự động sử dụng Local SQLite (data/bot_config.db)
TURSO_DATABASE_URL=libsql://mikebotdb-hoenmike.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here

# ==========================================
# ASUMI 3.1 CONVERSATIONAL CORE (OPTIONAL CLOUDFLARE ROUTER)
# ==========================================
# Mặc định để false: @Asumi vẫn chạy bằng local router + Gemini hiện tại.
# Bật true khi đã thêm Account ID + Workers AI API Token.
CF_ASSISTANT_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_ROUTER_MODEL=@cf/cloudflare/clef-flash
CF_ROUTER_MIN_CONFIDENCE=0.55
CF_ROUTER_TIMEOUT_SECONDS=4

# Conversational generation: ưu tiên quota/RPD cao cho chat thường.
# 3.8 Flash vẫn nằm trong fallback list hiện tại nếu 3.5 Flash-Lite lỗi.
ASUMI_CHAT_MODEL=gemini-3.5-flash-lite
# Lightweight fallback first; heavier summary models stay later in the chain.
ASUMI_CHAT_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# Per-model timeout and hard total AI budget for one conversational reply.
ASUMI_CHAT_MODEL_TIMEOUT_SECONDS=4
ASUMI_CHAT_TOTAL_BUDGET_SECONDS=8
ASUMI_CHAT_MAX_ATTEMPTS=2

# Short-lived reply continuation session
ASUMI_SESSION_TTL_SECONDS=1200
ASUMI_SESSION_MAX_TURNS=4


# ==========================================
# ASUMI 3.2 CONTEXT + LENS
# ==========================================
# Recent history chỉ được fetch khi câu hỏi có referent/cue cần context.
ASUMI_CONTEXT_RECENT_MESSAGES=8
ASUMI_CONTEXT_MAX_CHARS=7000

# Image Lens: ảnh chỉ giữ tạm trong live session, không persist DB/R2.
ASUMI_CONTEXT_MAX_IMAGES=2
ASUMI_CONTEXT_MAX_IMAGE_BYTES=5242880


# ==========================================
# ASUMI 3.3.1 ARCHIVE SEMANTIC (OPTIONAL)
# ==========================================
# Mặc định OFF: Archive 3.3.0 vẫn Search lexical bình thường.
# Workers AI token hiện tại dùng để tạo embedding.
# Vectorize nên dùng token riêng để không đụng credential Clef đang chạy.
CF_ARCHIVE_SEMANTIC_ENABLED=false
CLOUDFLARE_VECTORIZE_TOKEN=
CF_ARCHIVE_VECTORIZE_INDEX=asumi-archive-v1
CF_ARCHIVE_EMBEDDING_MODEL=@cf/baai/bge-m3
CF_ARCHIVE_VECTOR_DIMENSIONS=1024
CF_ARCHIVE_SEMANTIC_TIMEOUT_SECONDS=6
CF_ARCHIVE_SEMANTIC_MIN_SCORE=0.45
# Guard chống burst Save/Search tạo quá nhiều request Workers AI + Vectorize đồng thời.
CF_ARCHIVE_SEMANTIC_MAX_CONCURRENCY=3


# ==========================================
# T22.1 ASUMI BRAVE WEB SEARCH (OPTIONAL, OFF BY DEFAULT)
# ==========================================
# Tạo Search API key ở https://api-dashboard.search.brave.com/
# $5 credit/tháng tương đương ~1000 Search requests theo giá hiện tại.
# Giới hạn nội bộ <=900; 500 mặc định. Brave dashboard cũng nên đặt usage limit.
BRAVE_SEARCH_API_KEY=
ASUMI_WEB_SEARCH_ENABLED=false
ASUMI_WEB_SEARCH_MONTHLY_REQUEST_CAP=500
ASUMI_WEB_SEARCH_MAX_RESULTS=5
ASUMI_WEB_SEARCH_TIMEOUT_SECONDS=5
ASUMI_WEB_SEARCH_USER_COOLDOWN_SECONDS=15
ASUMI_WEB_SEARCH_CACHE_TTL_SECONDS=180


# ==========================================
# T22.2 DISCORD NATIVE HISTORY SEARCH (ON-DEMAND)
# ==========================================
# Chưa auto-index. Tìm lịch sử thật qua Discord REST API khi được @Asumi yêu cầu.
# Chỉ trả nội dung kênh mà cả user hỏi và bot đều có quyền đọc.
# OFF mặc định đến khi smoke-test bot token + quyền thành công trên server.
ASUMI_DISCORD_HISTORY_ENABLED=false
ASUMI_DISCORD_HISTORY_TIMEOUT_SECONDS=5
ASUMI_DISCORD_HISTORY_MAX_CALLS=3
ASUMI_DISCORD_HISTORY_MAX_RESULTS=5
ASUMI_DISCORD_HISTORY_COOLDOWN_SECONDS=20


# T22.3 CLEF AUTO SOURCE SELECTION (OPT-IN)
# Khi bật: Clef có thể đề xuất Brave / Discord History / Archive,
# nhưng chỉ gọi các provider đã enable và thỏa privacy/keyword gate.
ASUMI_AUTO_SEARCH_ENABLED=false
# Chỉ áp dụng với Brave do Clef chọn; Gemini tạo câu trả lời ngắn có nguồn.
ASUMI_WEB_SEARCH_SYNTHESIS_ENABLED=true
